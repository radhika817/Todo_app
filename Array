//buy and sell problem 
class Solution {
public:
    int maxProfit(vector<int>& prices) {
        int min=prices[0];
        int max_p=0;
        for(int i =0;i<prices.size();i++){
           
            if (prices[i]<min){
                min=prices[i];
            }
             if (prices[i] - min > max_p) {
                max_p = prices[i] - min;
            }
        }
        return max_p;
      
    }
};


// two sum
class Solution {
public:
    vector<int> twoSum(vector<int>& nums, int target) {
        for (int i = 0; i < nums.size(); i++) {
            for (int j = i + 1; j < nums.size(); j++) {
                if (nums[i] + nums[j] == target) {
                    return {i, j};
                }
            }
        }
    return{};
}
};

//consecutiveOnes
class Solution {
public:
    int findMaxConsecutiveOnes(vector<int>& nums) {
        int sum=0;
        int sum1=0;
        for(int i=0;i<nums.size();i++){
            if (nums[i]==1){
                sum++;
            }
            else {
                sum = 0;
            }

            if(sum1<sum)
            sum1=sum;
        }
        
        return sum1;
    
}
};

